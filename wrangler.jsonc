// Cloudflare Worker for pdf.kamtechsolutions.eu.
// Serves the static site (index.html and assets/).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-pdf",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The site lives in the repository root; .assetsignore keeps non-site files out of the upload.
    "directory": ".",
    "binding": "ASSETS"
  },
  // v1 created the Durable Object for the old visitor counter; v2 deletes it and its data.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] },
    { "tag": "v2", "deleted_classes": ["Counter"] }
  ]
}
